[node name="Dialogue5" type="Label" parent="."]
margin_left = 38.0
margin_top = 15.0
margin_right = 834.0
margin_bottom = 51.0
custom_colors/font_color = Color( 0.980392, 0.447059, 0.611765, 1 )
custom_fonts/font = SubResource( 107 )
text = "HOW TO PLAY"

[node name="Page1" type="Control" parent="."]
visible = false
margin_right = 40.0
margin_bottom = 40.0

[node name="Dialogue5" type="RichTextLabel" parent="Page1"]
margin_left = 40.0
margin_top = 76.0
margin_right = 711.0
margin_bottom = 288.0
custom_fonts/normal_font = SubResource( 106 )
bbcode_enabled = true
bbcode_text = "You are a naughty [color=#FA729C]tentacle god[/color] and your goal is to capture girls through [color=#FA729C]tentacle lockers.[/color]

Press [img]res://assets/game/KEYS/left_arrow.png[/img][img]res://assets/game/KEYS/right_arrow.png[/img][img]res://assets/game/KEYS/A.png[/img][img]res://assets/game/KEYS/D.png[/img] keys to move to the next left or right locker.

Use [img]res://assets/game/KEYS/space_bar.png[/img] to abduct a girl when they're in front of the currently active locker. Press [img]res://assets/game/KEYS/space_bar2.png[/img] to view the [color=#FA729C]locker scene[/color] of the current locker (the world is paused during a locker scene)."
text = "You are a naughty tentacle god and your goal is to capture girls through tentacle lockers.

Press  keys to move to the next left or right locker.

Use  to abduct a girl when they're in front of the currently active locker. Press  to view the locker scene of the current locker (the world is paused during a locker scene)."

[node name="Dialogue6" type="RichTextLabel" parent="Page1"]
margin_left = 39.0
margin_top = 298.0
margin_right = 752.0
margin_bottom = 381.0
custom_fonts/normal_font = SubResource( 106 )
bbcode_enabled = true
bbcode_text = "Lastly, you get [color=#FA729C]lust points[/color] [img]res://assets/ui/heart_emoji.png[/img] whenever a girl exits the locker. You can use it to unlock lewd content on [color=#FA729C]Fap Mode[/color]."
text = "Lastly, you get lust points  whenever a girl exits the locker. You can use it to unlock lewd content on Fap Mode."

[node name="Dialogue7" type="Label" parent="Page1"]
margin_left = 38.0
margin_top = 456.0
margin_right = 834.0
margin_bottom = 492.0
custom_colors/font_color = Color( 0.980392, 0.447059, 0.611765, 1 )
custom_fonts/font = SubResource( 110 )
text = "Page One: Gameplay and Controls"

[node name="Page2" type="Control" parent="."]
visible = false
margin_right = 40.0
margin_bottom = 40.0

[node name="Dialogue2" type="RichTextLabel" parent="Page2"]
margin_left = 36.0
margin_top = 99.0
margin_right = 707.0
margin_bottom = 182.0
custom_fonts/normal_font = SubResource( 106 )
bbcode_enabled = true
bbcode_text = "You get [color=#FA729C]skill points[/color] every time you level up. Use them to make new lockers. Press [img]res://assets/game/KEYS/R.png[/img] to open the [color=#FA729C]locker creator panel[/color] on an empty locker. Empty lockers don't have tentacles on the bottom part of their door."
text = "You get skill points every time you level up. Use them to make new lockers. Press  to open the locker creator panel on an empty locker. Empty lockers don't have tentacles on the bottom part of their door."

[node name="Dialogue3" type="RichTextLabel" parent="Page2"]
margin_left = 91.0
margin_top = 196.0
margin_right = 762.0
margin_bottom = 267.0
custom_fonts/normal_font = SubResource( 106 )
bbcode_enabled = true
bbcode_text = "The [color=#FA729C]basic locker[/color] allows you to abduct girls. It costs 2 skill points. It grows into the mature version [color=#FA729C]after 2 days.[/color]"
text = "The basic locker allows you to abduct girls. It costs 2 skill points. It grows into the mature version after 2 days."

