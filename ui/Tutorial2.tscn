[node name="Dialogue4" type="RichTextLabel" parent="Page3"]
margin_left = 36.0
margin_top = 99.0
margin_right = 707.0
margin_bottom = 392.0
custom_fonts/normal_font = SubResource( 106 )
bbcode_enabled = true
bbcode_text = "Make sure the girls don't see you whenever you [color=#FA729C]capture[/color] a girl. Or when a girl exits a locker and they see it. If so, they'll report you to the school management once they leave the hallway."
text = "Make sure the girls don't see you whenever you capture a girl. Or when a girl exits a locker and they see it. If so, they'll report you to the school management once they leave the hallway."

[node name="Dialogue5" type="RichTextLabel" parent="Page3"]
margin_left = 172.0
margin_top = 318.0
margin_right = 751.0
margin_bottom = 420.0
custom_fonts/normal_font = SubResource( 106 )
bbcode_enabled = true
bbcode_text = "Once the [color=#FA729C]alert meter[/color] reaches [color=#FA729C]50/50[/color], you're the one that will be caught and it's game over. You will then have to restart on your last saved check point  [color=#FA729C]3 days earlier[/color]."
text = "Once the alert meter reaches 50/50, you're the one that will be caught and it's game over. You will then have to restart on your last saved check point  3 days earlier."

